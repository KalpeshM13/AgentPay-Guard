# =============================================================================
# AgentPay Guard — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your setup:
#
#   cp .env.example .env
#
# NEVER commit .env to git.  On hosting platforms (Render, Railway, Fly.io),
# set these via the dashboard environment variables panel.
# =============================================================================

# -- Application ---------------------------------------------------------------
APP_NAME="AgentPay Guard"
APP_VERSION="0.1.0"
DEBUG=false

# -- Server --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS='["*"]'

# -- Database ------------------------------------------------------------------
# SQLite — zero setup required.  For production, use a managed Postgres:
#   postgresql+asyncpg://user:pass@host:5432/agentpay
DATABASE_URL="sqlite+aiosqlite:///data/agentpay.db"

# -- Logging -------------------------------------------------------------------
# text = human-readable with ANSI colours
# json = structured JSON for log aggregators (production)
LOG_LEVEL=INFO
LOG_FORMAT=text

# -- Security ------------------------------------------------------------------
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="change-me-in-production"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -- Default Owner (seeded on first startup) -----------------------------------
# Change these in production!
DEFAULT_OWNER_EMAIL="admin@agentpay.dev"
DEFAULT_OWNER_PASSWORD="admin123"

# -- Policy defaults -----------------------------------------------------------
DEFAULT_PER_TRANSACTION_LIMIT=1000.0
DEFAULT_DAILY_LIMIT=5000.0
DEFAULT_MAX_REQUESTS_PER_MINUTE=10

# -- Pending-payment window (seconds) ------------------------------------------
PENDING_DELAY_SECONDS=5.0

# -- AI Providers (optional — backend works without them) ----------------------
# Groq (free tier):  https://console.groq.com
# GROQ_API_KEY="gsk_..."
# GROQ_DEFAULT_MODEL="llama-3.1-8b-instant"

# Gemini (free tier):  https://aistudio.google.com
# GEMINI_API_KEY="AIza..."
# GEMINI_DEFAULT_MODEL="gemini-2.5-flash"
